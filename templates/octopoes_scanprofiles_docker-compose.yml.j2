# {{ ansible_managed }}
services:
  octopoes_scanprofiles:
    hostname: octopoes_scanprofiles
    restart: on-failure
    mem_limit: 1g
    cpus: 2.0
    command: ["scanprofiles"]
    image: "{{ openkat_docker_repository }}/openkat-octopoes:{{ openkat_octopoes_scanprofiles_version }}"
    environment:
      - QUEUE_URI=amqp://{{ openkat_rabbitmq_user }}:{{ openkat_rabbitmq_password }}@rabbitmq:5672/{{ openkat_rabbitmq_vhost }}
      - XTDB_URI=http://crux:3000
      - KATALOGUS_API=http://katalogus:8000

    ulimits:
      nofile:
        soft: 262144
        hard: 262144

    networks:
      openkatinternalnetwork:
        aliases:
          - octopoes_scanprofiles

networks:
  openkatinternalnetwork:
    external: true
