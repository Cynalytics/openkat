#!/usr/bin/env bash
# openkat-report — lijst OpenKAT-rapporten en haal de volledige rapport-JSON op.
#
#   Bron 1: octopoes  http://127.0.0.1:8001/<org>/reports   -> lijst + data_raw_id (metadata)
#   Bron 2: bytes     http://127.0.0.1:8002/bytes/raw/<id>  -> de volledige gerenderde rapport-JSON
#
# Beide API's luisteren alleen op localhost; dit script moet daarom OP de host draaien.
# Root is nodig (docker + bytes-credentials); zonder root her-exec't het script zichzelf via sudo.
#
# Gebruik:
#   openkat-report list     [-o ORG] [-n AANTAL]         # genummerde lijst, nieuwste bovenaan
#   openkat-report get      [-o ORG] [SELECTOR]          # de bytes-raw van dit rapport (letterlijk)
#   openkat-report meta     [-o ORG] [SELECTOR]          # alleen de octopoes-metadata (JSON)
#   openkat-report findings [-o ORG] [--full] [SELECTOR] # findings samengevoegd uit alle sub-reports
#   openkat-report history  [-o ORG] [--full] REFERENCE  # bitemporele transactie-tijdslijn van een OOI
#
# SELECTOR (voor get/meta/findings):
#   (leeg) of 'latest'   -> het nieuwste rapport
#   een nummer (1,2,..)  -> regelnummer uit 'list' (1 = nieuwste)
#   een raw-id (uuid)    -> get/meta: die bytes-raw rechtstreeks; findings: het top-level rapport met dat raw-id
#
# 'findings' lost een concatenated/multi-report op naar zijn asset-reports en voegt hun
# report_data samen tot een compacte JSON (findings, severity, occurrences, summary).
# Bij een rapport zonder sub-reports (bv. aggregate) valt het terug op de parent-raw.
#
# VERLEDEN / TIJDSLIJN (OpenKAT is bitemporeel):
#   * elk commando accepteert -t TIME om de graf op een eerder tijdstip te bevragen
#     (valid_time time-travel), bv. 'findings -t 2026-02-20T15:00:00Z ...'.
#   * 'history REFERENCE' geeft de transactiegeschiedenis van EEN OOI (bv. een Finding|...):
#     per transactie validTime (werkelijkheidstijd) + txTime; met --full ook het document.
#     REFERENCE is een volledige OOI-referentie, bv.
#     'Finding|Hostname|internet|example.com|KAT-NO-DNSSEC'.
#
# Opties:
#   -o ORG    organisatiecode (default: autodetectie; verplicht bij meerdere orgs)
#   -n N      aantal in 'list' (default 50)
#   -t TIME   valid_time override (ISO 8601, bv. 2026-07-20T12:00:00Z; default: nu)
#   --full    (findings) neem per sub-report de volledige raw mee (report_data + input_data)
#             plus de parent input_data, i.p.v. alleen report_data
set -euo pipefail

OCTOPOES_URL="http://127.0.0.1:8001"
BYTES_URL="http://127.0.0.1:8002"

die() { echo "openkat-report: $*" >&2; exit 1; }
show_help() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }

# --- root vereist (docker + bytes-creds) -----------------------------------
if [ "$(id -u)" -ne 0 ]; then exec sudo -- "$0" "$@"; fi

command -v python3 >/dev/null 2>&1 || die "python3 niet gevonden"
command -v curl    >/dev/null 2>&1 || die "curl niet gevonden"

# --- argument parsing ------------------------------------------------------
ORG=""; LIMIT=50; VALID_TIME=""
CMD="${1:-}"; [ -n "$CMD" ] && shift || true
case "$CMD" in list|get|meta|findings|history) ;; ""|-h|--help|help)
  show_help; exit 0 ;;
  *) die "onbekend commando '$CMD' (gebruik: list | get | meta | findings | history)";; esac

SELECTOR="latest"; FULL=0
while [ $# -gt 0 ]; do
  case "$1" in
    -o) ORG="${2:-}"; shift 2;;
    -n) LIMIT="${2:-}"; shift 2;;
    -t) VALID_TIME="${2:-}"; shift 2;;
    --full) FULL=1; shift;;
    -h|--help) show_help; exit 0;;
    -*) die "onbekende optie '$1'";;
    *) SELECTOR="$1"; shift;;
  esac
done

# valid_time: 'Z'-vorm; een '+' offset zou in de query-string als spatie worden gelezen.
[ -n "$VALID_TIME" ] || VALID_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- organisatie autodetecteren (via rocky) --------------------------------
detect_org() {
  local c
  c="$(docker ps --format '{{.Names}}' | grep -i rocky | grep -vi worker | head -1)" || true
  [ -n "$c" ] || return 1
  docker exec "$c" python manage.py shell -c \
    'from tools.models import Organization; print("\n".join(o.code for o in Organization.objects.all()))' \
    2>/dev/null
}
if [ -z "$ORG" ]; then
  mapfile -t _orgs < <(detect_org || true)
  case "${#_orgs[@]}" in
    0) die "kon geen organisatie detecteren; geef er een op met -o ORG";;
    1) ORG="${_orgs[0]}";;
    *) die "meerdere organisaties gevonden: ${_orgs[*]}; kies er een met -o ORG";;
  esac
fi

# --- octopoes: rapportlijst ophalen ----------------------------------------
octopoes_list() {
  curl -sf "$OCTOPOES_URL/$ORG/reports?limit=$LIMIT&valid_time=$VALID_TIME" \
    || die "octopoes-request faalde (org '$ORG', poort 8001 bereikbaar?)"
}

# resolve SELECTOR naar het volledige octopoes report-item (1 regel JSON)
resolve_item() {
  octopoes_list | SEL="$SELECTOR" python3 -c '
import sys, os, json, re
sel = os.environ["SEL"]
items = json.load(sys.stdin).get("items", [])
if not items: sys.exit("geen rapporten gevonden")
if re.match(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", sel):
    m = [it for it in items if it.get("data_raw_id") == sel]
    if not m: sys.exit("geen top-level rapport met data_raw_id %s (mogelijk een sub-report raw)" % sel)
    it = m[0]
else:
    idx = 1 if sel in ("", "latest") else None
    if idx is None:
        try: idx = int(sel)
        except ValueError: sys.exit("ongeldige selector: %s" % sel)
    if idx < 1 or idx > len(items): sys.exit("selector %d buiten bereik (1..%d)" % (idx, len(items)))
    it = items[idx-1]
print(json.dumps(it))
'
}

# --- bytes: creds (uit draaiende container, met compose als fallback) ------
bytes_creds() {  # echoot username op regel 1, password op regel 2
  local c
  c="$(docker ps --format '{{.Names}}' | grep -i bytes | grep -vi worker | head -1)" || true
  if [ -n "$c" ] && docker exec "$c" printenv BYTES_USERNAME BYTES_PASSWORD 2>/dev/null; then
    return 0
  fi
  local f u p
  for f in /opt/openkat/bytes/docker-compose.yml /srv/bytes/docker-compose.yml; do
    [ -r "$f" ] || continue
    u="$(sed -nE 's/.*BYTES_USERNAME=["'"'"' ]*([^"'"'"' ]+).*/\1/p' "$f" | head -1)"
    p="$(sed -nE 's/.*BYTES_PASSWORD=["'"'"' ]*([^"'"'"' ]+).*/\1/p' "$f" | head -1)"
    [ -n "$u" ] && [ -n "$p" ] && { printf '%s\n%s\n' "$u" "$p"; return 0; }
  done
  return 1
}

bytes_token() {
  local creds u p
  creds="$(bytes_creds)" || die "kon bytes-credentials niet vinden (container noch compose)"
  u="$(printf '%s\n' "$creds" | sed -n '1p')"
  p="$(printf '%s\n' "$creds" | sed -n '2p')"
  curl -sf -X POST "$BYTES_URL/token" \
    -H 'content-type: application/x-www-form-urlencoded' \
    --data-urlencode "username=$u" \
    --data-urlencode "password=$p" \
    | python3 -c 'import sys,json; print(json.load(sys.stdin)["access_token"])' \
    || die "bytes-login faalde"
}

fetch_raw() {  # $1 = raw_id
  local tok; tok="$(bytes_token)"
  curl -sf "$BYTES_URL/bytes/raw/$1" -H "Authorization: bearer $tok" \
    || die "bytes-raw $1 ophalen faalde"
}

# --- SELECTOR -> raw_id (+ meta) resolven -----------------------------------
UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

case "$CMD" in
  list)
    octopoes_list | python3 -c '
import sys, json
d = json.load(sys.stdin)
items = d.get("items", [])
print("# %d van %s rapport(en) — nieuwste eerst" % (len(items), d.get("count")))
print("%2s  %-27s  %-34s  %s" % ("#", "gegenereerd", "type", "raw-id"))
for i, it in enumerate(items, 1):
    print("%2d  %-27s  %-34s  %s" % (i, str(it.get("date_generated")), str(it.get("report_type")), it.get("data_raw_id")))
    print("    " + str(it.get("name")))
'
    ;;
  get|meta)
    if [[ "$SELECTOR" =~ $UUID_RE ]]; then
      RAW_ID="$SELECTOR"; META="null"
    else
      RESOLVED="$(octopoes_list | SEL="$SELECTOR" python3 -c '
import sys, os, json
sel = os.environ["SEL"]
idx = 1 if sel in ("", "latest") else None
if idx is None:
    try: idx = int(sel)
    except ValueError: sys.exit("ongeldige selector: %s" % sel)
items = json.load(sys.stdin).get("items", [])
if not items: sys.exit("geen rapporten gevonden")
if idx < 1 or idx > len(items): sys.exit("selector %d buiten bereik (1..%d)" % (idx, len(items)))
it = items[idx-1]
print(it["data_raw_id"])
print(json.dumps(it))
')" || exit 1
      RAW_ID="$(printf '%s\n' "$RESOLVED" | sed -n '1p')"
      META="$(printf '%s\n' "$RESOLVED" | sed -n '2p')"
    fi
    if [ "$CMD" = "meta" ]; then
      [ "$META" = "null" ] && die "meta niet beschikbaar bij directe raw-id; gebruik een regelnummer"
      printf '%s\n' "$META" | python3 -m json.tool
    else
      fetch_raw "$RAW_ID" | python3 -m json.tool
    fi
    ;;
  findings)
    ITEM="$(resolve_item)" || exit 1
    TOK="$(bytes_token)"
    printf '%s' "$ITEM" | ITEM_TOK="$TOK" ITEM_BASE="$BYTES_URL" ITEM_FULL="$FULL" python3 -c '
import sys, os, json, urllib.request
item = json.load(sys.stdin)
tok  = os.environ["ITEM_TOK"]
base = os.environ["ITEM_BASE"]
full = os.environ["ITEM_FULL"] == "1"

def fetch(raw_id):
    req = urllib.request.Request(base + "/bytes/raw/" + raw_id,
                                 headers={"Authorization": "bearer " + tok})
    with urllib.request.urlopen(req) as r:
        return json.loads(r.read())

meta_keys = ("name", "report_type", "date_generated", "reference_date",
             "organization_code", "data_raw_id")
out = {"report": {k: item.get(k) for k in meta_keys}}

assets = [a for a in (item.get("input_oois") or [])
          if isinstance(a, dict) and a.get("data_raw_id")]

if assets:
    reports = []
    for a in assets:
        raw = fetch(a["data_raw_id"])
        entry = {"input_ooi": a.get("input_ooi"),
                 "report_type": a.get("report_type"),
                 "data_raw_id": a.get("data_raw_id")}
        if full:
            entry["raw"] = raw
        else:
            entry["report_data"] = raw.get("report_data", raw)
        reports.append(entry)
    out["asset_reports"] = reports
    if full:
        out["input_data"] = fetch(item["data_raw_id"]).get("input_data")
else:
    # geen sub-reports (bv. aggregate-report): de parent-raw bevat de data zelf
    out["report_data"] = fetch(item["data_raw_id"])

json.dump(out, sys.stdout, ensure_ascii=False)
sys.stdout.write("\n")
' || die "findings samenstellen faalde"
    ;;
  history)
    [ "$SELECTOR" = "latest" ] && die "history vereist een OOI-referentie, bv. 'Finding|Hostname|internet|example.com|KAT-NO-DNSSEC'"
    WITHDOCS=false; [ "$FULL" = "1" ] && WITHDOCS=true
    REFENC="$(REF="$SELECTOR" python3 -c 'import os,urllib.parse; print(urllib.parse.quote(os.environ["REF"], safe=""))')"
    curl -sf "$OCTOPOES_URL/$ORG/object-history?reference=$REFENC&sort_order=asc&with_docs=$WITHDOCS" \
      || die "object-history faalde (bestaat de referentie '$SELECTOR' in org '$ORG'?)"
    echo
    ;;
esac
